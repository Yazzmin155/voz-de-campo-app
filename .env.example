# Conector opcional para IBM watsonx.ai (nunca expongas estas llaves en el cliente)
# Si están vacías, Voz de Campo opera automáticamente en Modo Demo Local sin errores.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Opcional: IBM Watson Speech to Text (transcripción online)
WATSON_STT_API_KEY=
WATSON_STT_SERVICE_URL=
